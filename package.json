{
  "name": "restaurant-dashboard",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "next experimental-analyze",
    "bundle:check": "tsx scripts/check-bundle-size.ts",
    "drift": "tsx scripts/drift-watch.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "shots:auth": "tsx scripts/mobile-auth.ts",
    "shots": "tsx scripts/mobile-shots.ts",
    "shots:readme": "tsx scripts/readme-shots.ts",
    "perf:audit": "tsx scripts/perf-audit.ts",
    "perf:sweep": "tsx scripts/perf-sweep.ts",
    "perf:queries": "tsx scripts/perf-queries.ts",
    "perf:mobile-nav": "tsx scripts/mobile-transition-perf.ts",
    "eval:chat": "tsx -r ./scripts/lib/server-only-shim.cjs scripts/eval-chat/run.ts",
    "eval:llm": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config -r ./scripts/lib/server-only-shim.cjs scripts/eval-llm/run.ts",
    "eval:ingredient-match": "tsx scripts/eval-ingredient-match/run.ts",
    "css:extract": "tsx scripts/extract-prototype-css.ts",
    "tokens": "tsx scripts/counter-lint.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "shot": "tsx scripts/shot-page.ts",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "fidelity": "playwright test --project=fidelity --project=fidelity-mobile",
    "fidelity:report": "tsx scripts/fidelity-report.ts",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.99",
    "@ai-sdk/react": "^3.0.267",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@google/genai": "^2.18.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@upstash/redis": "^1.38.2",
    "ai": "^6.0.169",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.33.0",
    "next": "^16.3.2",
    "next-auth": "^4.24.15",
    "openai": "^6.49.0",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.3.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/culori": "^4.0.1",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "culori": "^4.0.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "libsodium-wrappers": "^0.8.4",
    "playwright": "^1.58.2",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "brace-expansion": "5.0.9",
    "express-rate-limit": "8.6.2",
    "lodash": "4.18.1",
    "minimatch": "9.0.9",
    "path-to-regexp": "8.4.2",
    "postcss": "8.5.26",
    "protobufjs": "7.6.5"
  },
  "browserslist": [
    "chrome >= 123",
    "safari >= 17.5",
    "firefox >= 120",
    "edge >= 123"
  ]
}
