# Copy relevant values into .env.local for dev, .env.test.local for E2E.
# Real values are gitignored; this file is the schema.

# --- E2E tests (.env.test.local) ---
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# Optional override; defaults to http://localhost:3000
# E2E_BASE_URL=http://localhost:3000

# --- Core app (.env.local) — see existing .env.local for the full list ---
# DATABASE_URL=
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# Optional: service shutdown gate. When set, every route shows the shutdown
# page (503 for /api/*) for everyone except OWNER users. Value is the
# displayed "out of service since" date. Remove + redeploy to reopen.
# SERVICE_SHUTDOWN_AT=2026-07-02
