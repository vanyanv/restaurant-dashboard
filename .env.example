# Copy relevant values into .env.local for dev, .env.test.local for E2E.
# Real values are gitignored; this file is the schema.

# --- E2E tests (.env.test.local) ---
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# Optional override; defaults to http://localhost:3000
# E2E_BASE_URL=http://localhost:3000

# --- Core app (.env.local) — see existing .env.local for the full list ---
# DATABASE_URL=
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# Optional: service shutdown gate. When set, every route shows the shutdown
# page (503 for /api/*) for everyone except OWNER users. Value is the
# displayed "out of service since" date. Remove + redeploy to reopen.
# SERVICE_SHUTDOWN_AT=2026-07-02

# ─── Store checks ────────────────────────────────────────────────────────────
# PIN emails to crew go through Resend. Without both, the Crew & PINs page
# says emails are off and owners hand PINs over in person.
# RESEND_API_KEY=
# CHECKS_EMAIL_FROM="Chris N Eddy's <checks@chrisneddys.com>"
# Base for the QR poster link, up to and including /checks (default: ${NEXTAUTH_URL}/checks).
# CHECKS_BASE_URL=https://dashboard.chrisneddys.com/checks
# Signs the 3-hour crew pass after a PIN (default: NEXTAUTH_SECRET).
# CHECKS_SECRET=

# Shop (chrisneddys.com merch). The dashboard reads and changes the shop only
# through the site's signed private API. SHOP_INTERNAL_API_SECRET must be the
# same 32+ character value on both Vercel projects. SHOP_ACCOUNT_ID is the one
# dashboard account that owns the shop; every other account sees "not connected".
SHOP_API_URL="https://chrisneddys.com"
SHOP_INTERNAL_API_SECRET=""
SHOP_ACCOUNT_ID=""
