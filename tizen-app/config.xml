<?xml version="1.0" encoding="UTF-8"?>
<!--
  ChrisnEddysTV: the menu board app for Samsung TVs and Samsung business displays (Tizen).
  The player is inside the app (index.html, written by scripts/tizen-player.ts);
  it talks to https://dashboard.chrisneddys.com for its pairing code, pictures and times.
  See README.md for how to install it.
-->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://dashboard.chrisneddys.com/tv" version="3.1.0" viewmodes="maximized">
    <access origin="https://dashboard.chrisneddys.com" subdomains="false"/>
    <tizen:application id="ChrisnEddy.ChrisnEddysTV" package="ChrisnEddy" required_version="2.3"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <icon src="icon.png"/>
    <name>ChrisnEddysTV</name>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <!-- For the Samsung TV API that turns the screen saver off while the menu shows. -->
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
    <tizen:profile name="tv"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
